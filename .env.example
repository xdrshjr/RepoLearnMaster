# ============================================================================
# RepoLearn 配置唯一说明（spec §4.1）
# 复制为 .env 后按需修改；`.\start.ps1` 首次运行会自动生成缺失的密钥。
# 所有变量都以 REPOLEARN_ 前缀开头，避免污染同机其他服务。
# ============================================================================

# --- 运行环境 ---------------------------------------------------------------
# development | production（-Prod 启动时由 start.ps1 覆盖）
REPOLEARN_ENV=development
# 端口（浏览器只认识 3000；8000/8787 只绑 127.0.0.1）
REPOLEARN_WEB_PORT=3000
REPOLEARN_API_PORT=8000
REPOLEARN_KERNEL_PORT=8787

# --- 存储 -------------------------------------------------------------------
# 默认 SQLite（WAL）；切 PG 时填 postgresql+asyncpg://user:pass@127.0.0.1:5432/repolearn
REPOLEARN_DATABASE_URL=sqlite+aiosqlite:///./var/data/repolearn.db
# LangGraph checkpoint 库必须与业务库物理隔离（spec §3.4）
REPOLEARN_CHECKPOINT_DB=./var/data/langgraph.sqlite
REPOLEARN_OBJECT_ROOT=./var/objects

# --- 安全 -------------------------------------------------------------------
# Fernet 密钥（32 字节 urlsafe base64）；首次运行由 start.ps1 生成
REPOLEARN_SECRET_KEY=
# BFF 与 internals 的共享令牌；首次运行由 start.ps1 生成
REPOLEARN_INTERNAL_TOKEN=
# 密钥轮换后的旧 key（逗号分隔，可选，用于平滑轮换）
REPOLEARN_SECRET_KEY_PREVIOUS=

# --- 外部服务 ---------------------------------------------------------------
# GitHub Personal Access Token（可选，建议配）；未配置时受 60 req/h 限流，配上为 5000。
# 改完必须重启 API 才生效（.env 只在启动时读一次）；验证：
#   .\.venv\Scripts\python.exe -m repolearn.cli doctor   # 显示 token 指纹
# 值不要带首尾空格：`Bearer  ghp_...` 会被 GitHub 判成 401 Bad credentials。
REPOLEARN_GITHUB_TOKEN=
# 仓库体量上限（MB）
REPOLEARN_MAX_REPO_MB=60
# GitHub 接入点（hardening spec §3.2.1）。默认就是官方站点；企业自建 GHE 形如
#   REPOLEARN_GITHUB_API_BASE=https://ghe.example.com/api/v3
#   REPOLEARN_GITHUB_WEB_BASE=https://ghe.example.com
# 端点返回值被当成**不可信数据**处理（html_url 白名单、重定向逐跳校验、体积双检），
# 但端点本身只能来自服务端环境变量：请求体里没有任何参数能改它（否则就是 SSRF）。
REPOLEARN_GITHUB_API_BASE=https://api.github.com
REPOLEARN_GITHUB_WEB_BASE=https://github.com

# --- 运行时状态目录 ---------------------------------------------------------
# preflight.json / ports.json / pid 文件放这里。默认 .run；e2e-real 会把它指到
# var/e2e/<runId>/run，使"这台机器的 Gate 0 结论"与运行实例一起隔离。
REPOLEARN_RUN_DIR=.run

# --- Agent 内核（@aragon-agent/core，spec §3.5）-----------------------------
REPOLEARN_KERNEL_URL=http://127.0.0.1:8787
# kernel | exec | template | auto  —— auto 按 A→B→C 降级（spec §3.5.3）
REPOLEARN_AGENT_RUNTIME=auto

# --- 任务与预算（spec §3.4 三级预算）---------------------------------------
# SQLite 单写者，默认 1；PG 下建议 2~4
REPOLEARN_MAX_CONCURRENT_JOBS=1
REPOLEARN_JOB_DEADLINE_MS=1500000
REPOLEARN_JOB_MAX_TOKENS=2000000
REPOLEARN_JOB_MAX_USD=50
# 心跳周期与回收阈值（spec §3.11.2）
REPOLEARN_HEARTBEAT_SECONDS=15
REPOLEARN_JOB_STALE_SECONDS=90

# --- 搜索（spec §8.2：scan 默认；fts 可选）--------------------------------
REPOLEARN_SEARCH=scan

# --- 可选能力开关 -----------------------------------------------------------
REPOLEARN_VISION_QA=0
REPOLEARN_PDF_DEFAULT_ENGINE=chromium

# --- 出站 HTTP 超时（秒）---------------------------------------------------
# 连接超时；读超时（长生成任务需要较长的读超时）
REPOLEARN_HTTP_TIMEOUT_CONNECT=5
REPOLEARN_HTTP_TIMEOUT_READ=60

# --- 发布门禁（spec §3.4 最小可发布阈值）----------------------------------
# 4 个章节全有、有效课时 ≥ 8、锚点覆盖率 ≥ 80% 才允许 status=ready，否则 partial
REPOLEARN_MIN_LESSONS_TO_PUBLISH=8
REPOLEARN_MIN_ANCHOR_COVERAGE=0.8
REPOLEARN_MIN_SECTIONS_TO_PUBLISH=4

# --- 豆包（火山引擎）TTS；也可在 /setup 向导里配置后落库 ---------------
REPOLEARN_DOUBAO_APP_ID=
REPOLEARN_DOUBAO_ACCESS_TOKEN=
REPOLEARN_DOUBAO_CLUSTER=volcano_tts
REPOLEARN_DOUBAO_VOICE_TYPE=zh_female_wanwanxiaohe_moon_bigtts

# --- 前端（BFF 服务端专用，禁止导出到客户端组件）-------------------------
REPOLEARN_API_BASE=http://127.0.0.1:8000
# 离线演示 / E2E 用；1 时 BFF 不改写上游
REPOLEARN_WEB_MOCK=0
