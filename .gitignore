# --- 环境与密钥 ---
.env
.env.local
# 排障时留下的 .env 副本（可能含密钥，绝不能入库）
.env.broken-*
*.pem

# --- 运行时数据 ---
var/
.run/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Python ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Node / Next.js ---
node_modules/
.next/
# 真链路 E2E 用的独立构建目录（`REPOLEARN_NEXT_DIST_DIR=.next-e2e`，避免与
# `start.ps1` 的 `next dev` 抢同一份 `.next` 而互相写坏缓存）
.next-e2e/
out/
dist/
.turbo/
*.tsbuildinfo
apps/web/src/lib/api/schema.d.ts.bak

# --- 测试产物 ---
test-results/
playwright-report/
.playwright/
coverage/
htmlcov/

# --- 编排/运行时元数据（不属于产品代码）---
.agentmesh/

# --- 编辑器 / 系统 ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
