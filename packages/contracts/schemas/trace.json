{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SimulatedTrace",
  "type": "object",
  "required": ["key", "title", "steps"],
  "properties": {
    "key": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "title", "certainty"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "certainty": { "enum": ["source_fact", "static_inference", "teaching_simulation"] },
          "detail": { "type": "string", "maxLength": 1200 },
          "evidence": { "type": "array", "items": { "type": "object" } },
          "variables": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "value": { "type": "string" },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
