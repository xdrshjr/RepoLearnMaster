{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LessonPlayback",
  "type": "object",
  "required": ["key", "title", "layer", "steps"],
  "properties": {
    "key": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "layer": { "enum": ["overview", "walkthrough", "deep_dive", "recap"] },
    "minutes": { "type": "integer", "minimum": 1, "maximum": 40 },
    "goal": { "type": "string", "maxLength": 600 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "title", "duration_ms", "segments"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "duration_ms": { "type": "integer", "minimum": 1000, "maximum": 1800000 },
          "timing_source": { "enum": ["tts", "estimated"] },
          "segments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "text", "start_ms", "end_ms"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "text": { "type": "string", "minLength": 1 },
                "start_ms": { "type": "integer", "minimum": 0 },
                "end_ms": { "type": "integer", "minimum": 0 },
                "focus": {
                  "type": "object",
                  "required": ["file", "line_start", "line_end"],
                  "properties": {
                    "file": { "type": "string" },
                    "line_start": { "type": "integer", "minimum": 1 },
                    "line_end": { "type": "integer", "minimum": 1 }
                  }
                },
                "board_actions": { "type": "array", "items": { "type": "object" } },
                "subtitle_style": { "enum": ["normal", "emphasis", "aside"] }
              }
            }
          },
          "board": {
            "type": "object",
            "required": ["kind", "mermaid"],
            "properties": {
              "kind": { "enum": ["architecture", "flow"] },
              "mermaid": { "type": "string", "minLength": 1 },
              "nodes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "label"],
                  "properties": {
                    "id": { "type": "string" },
                    "label": { "type": "string" },
                    "source": {
                      "type": "object",
                      "properties": { "file": { "type": "string" }, "line": { "type": "integer", "minimum": 1 } }
                    }
                  }
                }
              }
            }
          },
          "code_notes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file", "line", "text"],
              "properties": {
                "file": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 },
                "text": { "type": "string", "maxLength": 600 }
              }
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": { "path": { "type": "string" }, "lang": { "type": "string" } }
      }
    },
    "trace_key": { "type": "string" },
    "quiz": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "stem", "choices", "answer_id", "explanation_md", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "stem": { "type": "string", "minLength": 1, "maxLength": 600 },
          "choices": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": ["id", "text"],
              "properties": { "id": { "type": "string" }, "text": { "type": "string" } }
            }
          },
          "answer_id": { "type": "string", "minLength": 1 },
          "explanation_md": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "object" } },
          "difficulty": { "type": "integer", "minimum": 1, "maximum": 3 },
          "kind": { "enum": ["prediction", "recall", "trace"] }
        }
      }
    }
  }
}
