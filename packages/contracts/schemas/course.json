{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CourseCurriculum",
  "type": "object",
  "required": ["title", "sections"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "subtitle": { "type": "string", "maxLength": 300 },
    "summary_md": { "type": "string", "maxLength": 4000 },
    "chain_id": { "type": "string" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "title", "lessons"],
        "properties": {
          "key": { "enum": ["overview", "walkthrough", "deep_dive", "recap"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "minutes": { "type": "integer", "minimum": 1, "maximum": 120 },
          "lessons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["key", "title", "goal"],
              "properties": {
                "key": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1, "maxLength": 120 },
                "goal": { "type": "string", "minLength": 1, "maxLength": 600 },
                "minutes": { "type": "integer", "minimum": 1, "maximum": 30 },
                "anchors": { "type": "array", "items": { "$ref": "#/definitions/anchor" } }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "anchor": {
      "type": "object",
      "required": ["file", "line_start", "line_end"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string" },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["definition", "call_site", "config", "test"] }
      }
    }
  }
}
